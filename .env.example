# Django
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_NAME=jobcrawler
DB_USER=postgres
DB_PASSWORD=postgres

# LLM - Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60

# Redis (caching)
REDIS_URL=redis://redis:6379/0
CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Crawler
CRAWLER_LOCALE=ko-KR
CRAWLER_TIMEZONE=Asia/Seoul
CRAWLER_TIMEOUT=60
BATCH_CRAWL_MAX_PAGES=1
AGENT_CRAWL_MAX_PAGES=1
